# CUSTOM External Supabase Configuration (RECOMMENDED - Bolt won't auto-manage)
# Use these to prevent Bolt.new from overwriting your external database credentials
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
CUSTOM_SUPABASE_URL=your_supabase_project_url
CUSTOM_SUPABASE_ANON_KEY=your_supabase_anon_key
CUSTOM_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Standard Supabase Configuration (FALLBACK - Bolt may auto-manage these)
# Only needed if not using CUSTOM_ variables above
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paddle Payment Gateway
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=your_pro_price_id
NEXT_PUBLIC_PADDLE_AGENCY_PRICE_ID=your_agency_price_id

# Paddle Webhook Secret
PADDLE_WEBHOOK_SECRET=your_webhook_secret
